/# Per-maze run subfolders (for example runs/default/, runs/pinklike/)
/benchmarl_setup/runs/*/iql_pacman_*
/benchmarl_setup/runs/*/vdn_pacman_*
/benchmarl_setup/runs/*/qmix_pacman_*
/benchmarl_setup/runs/*/live_progress.csvl
/benchmarl_setup/runs/*/benchmark_summary.csv

# Decisive reward A/B (plan-000031): keep the heavy per-run blobs ignored, but
# track the small report-facing artifacts (manifest, comparison table, figures)
# for C1 provenance. The directory must be un-ignored first (parent of /runs/* is
# excluded) before specific files inside it can be re-included.
!/benchmarl_setup/runs/ab/
/benchmarl_setup/runs/ab/*
!/benchmarl_setup/runs/ab/ab_manifest.csv
!/benchmarl_setup/runs/ab/reward_ab.csv
!/benchmarl_setup/runs/ab/*.png

# Render screenshots
/benchmarl_setup/runs/pacman_render*.png
/benchmarl_setupruns*.png
/pacman_render*.png

/output.txt
